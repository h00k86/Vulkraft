@PACKAGE_INIT@
set(GraphicsApp_VERSION "@GRAPHICS_APP_VERSION@")
set(GraphicsApp_PLATFORM "@GRAPHICS_APP_PLATFORM@")
# Compute before nested package discovery (which can modify PACKAGE_PREFIX_DIR).
set_and_check(GraphicsApp_RESOURCE_DIR "@PACKAGE_CMAKE_INSTALL_DATADIR@/graphics-app/resources")
include(CMakeFindDependencyMacro)
find_dependency(UIFramework @PROJECT_VERSION@ EXACT COMPONENTS picker)
find_dependency(Vulkan 1.3)
if(GraphicsApp_PLATFORM STREQUAL "glfw")
  find_dependency(glfw3 3.3)
else()
  find_dependency(PkgConfig)
  pkg_check_modules(GRAPHICS_APP_SDL2 QUIET IMPORTED_TARGET sdl2>=2.26.0)
  if(NOT GRAPHICS_APP_SDL2_FOUND)
    set(GraphicsApp_FOUND FALSE)
    set(GraphicsApp_NOT_FOUND_MESSAGE "GraphicsApp requires SDL2 >= 2.26.0")
    return()
  endif()
endif()
include("${CMAKE_CURRENT_LIST_DIR}/GraphicsAppTargets.cmake")
include("${CMAKE_CURRENT_LIST_DIR}/GraphicsAppResources.cmake")
set(GraphicsApp_application_FOUND TRUE)
check_required_components(GraphicsApp)
