@PACKAGE_INIT@
set(UIFramework_VERSION "@PROJECT_VERSION@")
set(UIFramework_FOUND TRUE)
unset(UIFramework_NOT_FOUND_MESSAGE)
include("${CMAKE_CURRENT_LIST_DIR}/UIFrameworkCoreTargets.cmake")
set(UIFramework_core_FOUND TRUE)
set(UIFramework_picker_FOUND FALSE)
set(UIFramework_sdl2_FOUND FALSE)
# Without an explicit list, preserve the original all-installed-components API.
set(_UIFramework_components "${UIFramework_FIND_COMPONENTS}")
if(NOT _UIFramework_components)
  set(_UIFramework_components core)
  if(@UI_WITH_PICKER@)
    list(APPEND _UIFramework_components picker)
  endif()
  if(@UI_WITH_SDL2@)
    list(APPEND _UIFramework_components sdl2)
    set(UIFramework_FIND_REQUIRED_sdl2 TRUE)
  endif()
endif()
foreach(_UIFramework_component IN LISTS _UIFramework_components)
  if(_UIFramework_component STREQUAL "picker" AND @UI_WITH_PICKER@)
    include("${CMAKE_CURRENT_LIST_DIR}/UIFrameworkPickerTargets.cmake")
    set(UIFramework_picker_FOUND TRUE)
  elseif(_UIFramework_component STREQUAL "sdl2" AND @UI_WITH_SDL2@)
    # QUIET probes allow OPTIONAL_COMPONENTS and non-REQUIRED find_package calls.
    find_package(PkgConfig QUIET)
    if(PkgConfig_FOUND)
      pkg_check_modules(UI_SDL_DEPS QUIET IMPORTED_TARGET sdl2>=2.0.18 SDL2_image freetype2)
      if(UI_SDL_DEPS_FOUND)
        include("${CMAKE_CURRENT_LIST_DIR}/UIFrameworkSDL2Targets.cmake")
        set(UIFramework_sdl2_FOUND TRUE)
      endif()
    endif()
  elseif(NOT _UIFramework_component STREQUAL "core")
    set(UIFramework_${_UIFramework_component}_FOUND FALSE)
  endif()
  if(NOT UIFramework_${_UIFramework_component}_FOUND AND UIFramework_FIND_REQUIRED_${_UIFramework_component})
    set(UIFramework_FOUND FALSE)
    set(UIFramework_NOT_FOUND_MESSAGE "Requested component '${_UIFramework_component}' is not installed or its dependencies are unavailable.")
  endif()
endforeach()
unset(_UIFramework_component)
unset(_UIFramework_components)
check_required_components(UIFramework)
